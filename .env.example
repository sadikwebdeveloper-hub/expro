# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
APP_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# JWT
#
# NOTE: this value also derives the key used to encrypt the stored SMTP
# password (server/services/cryptoService.js). Changing it on an existing
# deployment invalidates that password — re-enter it in Settings -> SMTP.
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# SMTP
#
# Fallback only: values saved in the admin panel (Settings -> SMTP) take
# precedence. Gmail requires an App Password, not the account password, and the
# From address must match the authenticated user.
#
# Port 465 = SSL, 587 = STARTTLS. SMTP_ENCRYPTION overrides port detection and
# accepts SSL | TLS | NONE.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_ENCRYPTION=SSL
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=Expro Group
SMTP_FROM_EMAIL=you@gmail.com
MAIL_REPLY_TO=you@gmail.com

# ---------------------------------------------------------------------------
# Cloudinary (optional — falls back to the local uploads/ directory)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Testing / advanced
# ---------------------------------------------------------------------------
# EXPRO_DATA_FILE=/tmp/expro-data.json
